<Window x:Class="BranchTaskWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BranchTaskWpf.ViewModels"
        xmlns:cv="clr-namespace:BranchTaskWpf.Converters"
        xmlns:models="clr-namespace:BranchTaskWpf.Models"
        xmlns:views="clr-namespace:BranchTaskWpf.Views"
        xmlns:local="clr-namespace:BranchTaskWpf"
        Title="新新的任务树"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="250"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:StatusColorConverter x:Key="StatusColor"/>
        <cv:StatusTextConverter x:Key="StatusText"/>
        <cv:BoolToWidthConverter x:Key="BoolToWidth"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <cv:UnixToBeijingConverter x:Key="UnixToBeijing"/>
        <local:TreeLineVertVisibilityConverter x:Key="TreeLineVertVis"/>
        <local:TreeLineHorizVisibilityConverter x:Key="TreeLineHorizVis"/>
        <cv:LevelColorConverter x:Key="LevelColor"/>
        <cv:TextToVisibilityConverter x:Key="TextToVis"/>
        <cv:ProjectColorConverter x:Key="ProjectColor"/>
        <cv:FirstCharConverter x:Key="FirstChar"/>
        <cv:EqualConverter x:Key="EqualConv"/>
        
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button" x:Key="StatusPickBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TreeViewItem 样式：带标准树形连接线（竖线 + 横向肘线 + 圆点）
             OverridesDefaultStyle=True：彻底绕过 Windows 主题默认的 ~19px 左缩进，
             否则即使 Margin=0/Padding=0，框架仍会把整个 TreeViewItem 向右推，
             导致层级色左侧留白（btwpf36 诊断截图确认：洋红/黄都没露出来，
             白边在 TreeViewItem 容器级，非 TabItem/TreeView 层）。 -->
        <Style TargetType="TreeViewItem" BasedOn="{x:Null}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- IsSelected 用 OneWay：模型(VM.SelectedNode)是唯一真源，UI 选中经 Tree_SelectedItemChanged → VM.SelectedNode 维护单选。
                 若用 TwoWay，在 FilteredRoots 重建(_suppressSelectionSync)期间 UI 选中会直接写回 TaskNode.IsSelected，
                 旧项未被清除而新项又置 true → 多节点 IsSelected 累积，表现为"全选"。 -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- 层级配色：直接设在 TreeViewItem 自身 Background，铺满整行（含缩进区） -->
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource LevelColor}">
                        <Binding Path="TreeLevel"/>
                        <Binding Path="DataContext.ColorByLevel" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <!-- 关键修复：每个 TreeViewItem 的子节点容器默认是 VirtualizingStackPanel，
                 在 ScrollViewer 物理滚动下收到无限高度会错误测量、把子项推到巨大偏移。
                 换成普通 StackPanel 后，子项按实际高度从顶部正确堆叠。 -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <!-- 关键：用 TemplateBinding Background 把层级配色真正画出来。
                             Style 里 MultiBinding 算出的层级色赋在 TreeViewItem.Background 上，
                             模板不引用它就永远是透明（之前"没颜色"的根因）。此 Grid 跨两列，
                             背景铺满整行（含缩进区），实现层级色贯通。 -->
                        <Grid x:Name="RowGrid" ClipToBounds="False" Margin="0" HorizontalAlignment="Stretch"
                              Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 竖向延续线：仅在"有子节点"时显示；高度/位置由代码(TreeLineHelper)精确测量设置，
                                 从自身表头中心连到最后一个子节点表头中心，避免上下出头。
                                 关键：用 ZeroMeasureDecorator 包裹——Measure 返回 0，竖线高度变化绝不参与
                                 Grid 行高计算，因此折叠/展开时容器尺寸不变、节点位置不跳；绘制仍按真实尺寸。 -->
                            <local:ZeroMeasureDecorator Grid.Column="0" Grid.Row="0" Grid.RowSpan="2">
                                <Rectangle Width="1" Fill="#D0D0D0" Tag="VLine"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Height="0"
                                           Visibility="Collapsed"/>
                            </local:ZeroMeasureDecorator>

                            <!-- 横向肘线：有父节点(TreeLevel>0)才显示；从父竖线(-10)连到本节点竖线(0) -->
                            <!-- 可见性由代码(TreeLineHelper)直接设置，避免 ControlTemplate 内绑定不刷新；
                                 同样用 ZeroMeasureDecorator 包裹，不参与布局测量。 -->
                            <local:ZeroMeasureDecorator Grid.Column="0" Grid.Row="0">
                                <Rectangle Width="20" Height="1" Fill="#D0D0D0" Tag="HLine"
                                           HorizontalAlignment="Left" Margin="-10,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </local:ZeroMeasureDecorator>

                            <!-- 展开/折叠三角按钮 -->
                            <ToggleButton x:Name="Expander" Grid.Column="0" Grid.Row="0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Width="18" Height="18" Padding="0" BorderThickness="0"
                                          Background="Transparent" Cursor="Hand" ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                <Path x:Name="ExpanderArrow" Data="M 0 0 L 7 5 L 0 10 Z"
                                      Fill="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- 表头内容（状态圆点 + 标题） -->
                            <Border x:Name="HeaderBorder" Grid.Column="1" Grid.Row="0"
                                    Padding="2,2" Background="Transparent">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 子节点容器 -->
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1"
                                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderArrow" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="ExpanderArrow" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>

                            <!-- 老版本 egui 选中方式：深蓝灰实底(86,96,128) + 白色文字（不与浅色层级配色撞） -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#566080"/>
                                <Setter TargetName="HeaderBorder" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="HeaderBorder" Property="TextElement.Foreground" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TreeItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="TreeItem_PreviewMouseMove"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TreeItem_PreviewMouseLeftButtonUp"/>
            <EventSetter Event="Drop" Handler="TreeItem_Drop"/>
            <EventSetter Event="DragOver" Handler="TreeItem_DragOver"/>
            <EventSetter Event="DragLeave" Handler="TreeItem_DragLeave"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftPanelOpen, Converter={StaticResource BoolToWidth}, ConverterParameter=220:48}"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="RightCol" Width="{Binding RightColumnWidth}" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左栏：项目列表 ===== -->
        <Grid Grid.Column="0" Background="#F5F5F5"
              Visibility="{Binding LeftPanelOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 项目标题栏：新建项目移到标题旁 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0"
                        Background="#F5F5F5" VerticalAlignment="Center">
                <TextBlock Text="项目" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <!-- 新建项目（+ 号），移到「项目」文字右边 -->
                <Button Style="{StaticResource ToolBtn}" Command="{Binding AddProjectCommand}"
                        ToolTip="新建项目" Padding="2,0" Margin="6,0,0,0">
                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" Foreground="#2C7BE5"
                               VerticalAlignment="Center" LineHeight="20"/>
                </Button>
                <Button Content="◀" Style="{StaticResource ToolBtn}"
                        Click="ToggleLeftPanel" Margin="12,0,0,0" ToolTip="收起项目栏"/>
            </StackPanel>

            <ListBox x:Name="_projectListBox" Grid.Row="1" ItemsSource="{Binding Projects}" 
                     SelectedItem="{Binding SelectedProject}"
                     BorderThickness="0" Background="Transparent" Margin="4,0"
                     AllowDrop="True" Focusable="True"
                     PreviewMouseLeftButtonDown="ProjectList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ProjectList_PreviewMouseMove"
                     DragOver="ProjectList_DragOver"
                     Drop="ProjectList_Drop">
                <!-- 让每一项横向拉伸充满整行，整行（不只文字）都能右键 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2" MouseRightButtonUp="ProjectItem_RightClick">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="6,4"
                                       MouseDown="ProjectTitle_MouseDown"/>
                            <TextBox x:Name="EditBox" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center" Padding="6,4" FontSize="12"
                                     Visibility="Collapsed"
                                     LostFocus="ProjectTitle_LostFocus" KeyDown="ProjectTitle_KeyDown"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 收起态：项目缩略图条（参考老版本，色块点击即切换项目） -->
        <Grid Grid.Column="0" Background="#F5F5F5"
              Visibility="{Binding LeftPanelOpen, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Content="▶" Style="{StaticResource ToolBtn}"
                    Click="ToggleLeftPanel" ToolTip="展开项目栏"
                    Margin="4,6" HorizontalAlignment="Center"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ProjectTile_Click" Tag="{Binding}" ToolTip="{Binding Name}"
                                    Width="34" Height="34" Margin="7,3" Padding="0"
                                    BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <MultiBinding Converter="{StaticResource ProjectColor}">
                                        <Binding/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}"
                                                Path="DataContext.Projects"/>
                                    </MultiBinding>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualConv}">
                                                        <Binding/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}"
                                                                Path="DataContext.SelectedProject"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Name, Converter={StaticResource FirstChar}}"
                                           Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           MouseRightButtonUp="ProjectTile_RightClick"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 左栏拖拽手柄 -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

        <!-- ===== 中栏：大纲树 ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 搜索框：圆角边框 + 放大镜 + 清除按钮 -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                            CornerRadius="15" Padding="8,3" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Left"
                                  Data="M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12M15 15l5 5"
                                  Stroke="#909090" StrokeThickness="2" StrokeEndLineCap="Round"
                                  Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Button x:Name="SearchClearBtn" DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolBtn}"
                                    Foreground="#AAA" FontSize="11" Click="SearchClear_Click" Margin="4,0,0,0"
                                    Visibility="{Binding SearchText, Converter={StaticResource TextToVis}}"/>
                            <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" Width="200" Padding="0"
                                     VerticalContentAlignment="Center" ToolTip="搜索任务"/>
                        </DockPanel>
                    </Border>

                    <!-- 筛选按钮（漏斗图标）：位于搜索框与层级配色之间 -->
                    <Button Grid.Column="1" Style="{StaticResource ToolBtn}" Click="LeftFilterBtn_Click"
                            ToolTip="筛选" Margin="12,0,0,0" Padding="6,4" VerticalAlignment="Center">
                        <Grid Width="18" Height="18">
                            <Path Data="M2 2 L14 2 L10 8 L10 14 L6 16 L6 8 Z"
                                  Fill="#555" Stretch="Uniform"/>
                        </Grid>
                    </Button>

                    <!-- 层级配色开关 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Button Content="层级配色" Click="ToggleColorByLevel_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolBtn}">
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ColorByLevel}" Value="True">
                                            <Setter Property="Foreground" Value="#2C7BE5"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 操作按钮 + 详情面板开关 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋子" Style="{StaticResource ToolBtn}" Command="{Binding AddChildCommand}"/>
                        <Button Content="＋兄" Style="{StaticResource ToolBtn}" Command="{Binding AddSiblingCommand}"/>
                        <Button Content="🗑" Style="{StaticResource ToolBtn}" Command="{Binding DeleteNodeCommand}"/>
                        <Button Content="📄" Style="{StaticResource ToolBtn}" Click="ExportMd_Click" ToolTip="导出 MD"/>
                        <Button Content="▶" Style="{StaticResource ToolBtn}" Click="ToggleRightPanel" ToolTip="收起/展开详情"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" BorderThickness="0" Background="White">
                            <TabItem Header="大纲" Padding="0">
            <TreeView x:Name="outlineTree" ItemsSource="{Binding FilteredRoots}"
                      BorderThickness="0" Background="White" Padding="0"
                      VirtualizingStackPanel.IsVirtualizing="False"
                      VerticalAlignment="Top"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AllowDrop="True"
                      DragOver="TreeView_DragOver"
                      Drop="TreeView_Drop"
                      SelectedItemChanged="Tree_SelectedItemChanged">
                <!-- 关键修复：禁用虚拟化后 VirtualizingStackPanel 在 ScrollViewer 物理滚动(CanContentScroll=False)
                     下收到无限高度会错误测量，把节点撑成巨高。改用普通 StackPanel 作为 ItemsPanel，
                     在无限高度下正确按实际高度堆叠全部子节点。 -->
                <TreeView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </TreeView.ItemsPanel>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:TaskNode}" ItemsSource="{Binding Children}">
                        <Grid Margin="2" MouseRightButtonUp="TaskItem_RightClick">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10" Margin="0,0,6,0"
                                     Cursor="Hand" MouseUp="StatusDot_MouseUp"
                                     ToolTip="点击选择状态">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#CCCCCC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="in_progress">
                                                <Setter Property="Fill" Value="#2196F3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="done">
                                                <Setter Property="Fill" Value="#4CAF50"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="blocked">
                                                <Setter Property="Fill" Value="#F44336"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Padding="2"
                                       FontSize="13"
                                       MouseDown="TaskTitle_MouseDown" Tag="{Binding}"
                                       Visibility="Visible"/>
                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=LostFocus}" 
                                     VerticalAlignment="Center" Padding="2"
                                     FontSize="13"
                                     LostFocus="TaskTitle_LostFocus" KeyDown="TaskTitle_KeyDown"
                                     Visibility="Collapsed"/>
                            <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=StatusDot}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="4" Padding="4" SnapsToDevicePixels="True">
                                    <StackPanel>
                                        <Button Content="● 未标记" Tag="" Style="{StaticResource StatusPickBtn}"
                                                Click="StatusPick_Click"/>
                                        <Button Content="● 进行中" Tag="in_progress" Foreground="#2196F3"
                                                Style="{StaticResource StatusPickBtn}" Click="StatusPick_Click"/>
                                        <Button Content="● 已完成" Tag="done" Foreground="#4CAF50"
                                                Style="{StaticResource StatusPickBtn}" Click="StatusPick_Click"/>
                                        <Button Content="● 阻塞" Tag="blocked" Foreground="#F44336"
                                                Style="{StaticResource StatusPickBtn}" Click="StatusPick_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
                            </TabItem>
                            <TabItem Header="思维导图">
                                <Grid>
                                    <views:MindmapView x:Name="MindmapCanvas" RootNode="{Binding SelectedProject.Root}"/>
                                    <!-- 缩放按钮浮层 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,12,12" Background="#F0F0F0" Opacity="0.85">
                                        <Button Content="−" Width="28" Height="28" Style="{StaticResource ToolBtn}" FontSize="16"
                                                Click="ZoomOut_Click"/>
                                        <TextBlock x:Name="ZoomLevel" Text="100%" VerticalAlignment="Center" 
                                                   FontSize="12" Width="40" TextAlignment="Center" Foreground="#666"/>
                                        <Button Content="＋" Width="28" Height="28" Style="{StaticResource ToolBtn}" FontSize="16"
                                                Click="ZoomIn_Click"/>
                                        <Button Content="↺" Width="28" Height="28" Style="{StaticResource ToolBtn}" FontSize="14"
                                                Click="ZoomReset_Click" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
        </Grid>

        <!-- 中右拖拽手柄（拖拽后重建列宽绑定，避免覆盖收起逻辑） -->
        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0"
                      DragCompleted="RightSplitter_DragCompleted"/>

        <!-- ===== 右栏：详情面板 ===== -->
        <Grid Grid.Column="4">
            <!-- 展开态：完整详情 -->
            <Grid Background="#FAFAFA" Visibility="{Binding RightPanelOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid Margin="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DetailTabBtn" Content="详情" FontWeight="Bold" Foreground="#2C7BE5"
                                Style="{StaticResource ToolBtn}" Padding="6,2" Click="DetailTab_Click" Tag="detail"/>
                        <Button x:Name="LibraryTabBtn" Content="库" FontWeight="Normal" Foreground="#888"
                                Style="{StaticResource ToolBtn}" Padding="6,2" Margin="8,0,0,0"
                                Click="DetailTab_Click" Tag="library"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="DetailTabPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel DataContext="{Binding SelectedNode}">
                    <!-- 名称 -->
                    <TextBlock Text="名称" FontWeight="SemiBold" Margin="0,4,0,2" Foreground="#888" FontSize="12"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}" Padding="4" FontSize="14"
                             LostFocus="TaskField_LostFocus" KeyDown="TaskField_KeyDown"/>

                    <!-- 状态 -->
                    <TextBlock Text="状态" FontWeight="SemiBold" Margin="0,12,0,2" Foreground="#888" FontSize="12"/>
                    <ComboBox x:Name="StatusCombo" Padding="4"
                              SelectedValue="{Binding Status}" SelectedValuePath="Tag"
                              SelectionChanged="StatusCombo_SelectionChanged">
                        <ComboBoxItem Content="● 未标记" Tag=""/>
                        <ComboBoxItem Content="● 进行中" Tag="in_progress" Foreground="#2196F3"/>
                        <ComboBoxItem Content="● 已完成" Tag="done" Foreground="#4CAF50"/>
                        <ComboBoxItem Content="● 阻塞" Tag="blocked" Foreground="#F44336"/>
                    </ComboBox>

                    <!-- 任务信息 -->
                    <TextBlock Text="任务信息" FontWeight="SemiBold" Margin="0,16,0,2" Foreground="#888" FontSize="12"/>
                    <TextBox Text="{Binding TaskInfo, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True" MinHeight="80"
                             TextWrapping="Wrap" Padding="4"
                             VerticalScrollBarVisibility="Auto"
                             LostFocus="TaskField_LostFocus"/>

                    <Expander IsExpanded="True" Margin="0,8,0,0">
<Expander.Header>
<StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="中间结果" FontWeight="SemiBold" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="＋文件" Style="{StaticResource ToolBtn}" FontSize="10" Foreground="#888"
                                Click="AddTaskIM_Click" Tag="file" Margin="8,0,2,0"/>
                        <Button Content="＋链接" Style="{StaticResource ToolBtn}" FontSize="10" Foreground="#888"
                                Click="AddTaskIM_Click" Tag="link" Margin="2,0,0,0"/>
                    </StackPanel>
</Expander.Header>

                    <ItemsControl ItemsSource="{Binding Intermediates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=LostFocus}" 
                                                     FontSize="12" FontWeight="SemiBold" BorderThickness="0"
                                                     MinHeight="0" Height="20" Padding="0,2"
                                                     VerticalContentAlignment="Center"
                                                     LostFocus="TaskField_LostFocus" KeyDown="TaskField_KeyDown"/>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource ToolBtn}" 
                                                    Foreground="#CCC" FontSize="10"
                                                    Click="DeleteIM_Click" Tag="{Binding}"/>
                                        </Grid>
                                        <TextBox Text="{Binding Content, UpdateSourceTrigger=LostFocus}"
                                                 AcceptsReturn="True" MinHeight="30"
                                                 TextWrapping="Wrap" BorderThickness="0" Padding="2"
                                                 LostFocus="TaskField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="text">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <!-- 链接 URL 编辑框（仅 link 类型可见） -->
                                        <TextBox Text="{Binding Link, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="11" BorderBrush="#E0E0E0" BorderThickness="1"
                                                 Padding="4" Margin="0,4,0,0"
                                                 LostFocus="TaskField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="link">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <!-- 文件路径显示（仅 file 类型可见） -->
                                        <TextBox Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="11" Foreground="#888" BorderThickness="0"
                                                 Padding="2" Margin="0,2,0,0"
                                                 LostFocus="TaskField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="file">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Kind, StringFormat='类型: {0}'}" 
                                                       FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="📂 打开" FontSize="10" Foreground="#4A90D9"
                                                        Click="OpenFile_Click" Tag="{Binding FilePath}"
                                                        Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="file">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🔗 打开" FontSize="10" Foreground="#4A90D9"
                                                        Click="OpenLink_Click" Tag="{Binding Link}"
                                                        Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="link">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="✕" Style="{StaticResource ToolBtn}" 
                                                        Foreground="#CCC" FontSize="10"
                                                        Click="DeleteIM_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </Expander>
<Expander IsExpanded="True" Margin="0,8,0,0">
<Expander.Header>
<StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="项目里程碑" FontWeight="SemiBold" Foreground="#888" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="＋文件" Style="{StaticResource ToolBtn}" FontSize="10" Foreground="#888"
                                Click="AddProjIM_Click" Tag="file" Margin="8,0,2,0"/>
                        <Button Content="＋链接" Style="{StaticResource ToolBtn}" FontSize="10" Foreground="#888"
                                Click="AddProjIM_Click" Tag="link" Margin="2,0,0,0"/>
                    </StackPanel>
</Expander.Header>

                    <ItemsControl ItemsSource="{Binding DataContext.SelectedProject.Intermediates, 
                                        RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,2" Padding="6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=LostFocus}" 
                                                     FontSize="12" FontWeight="SemiBold" BorderThickness="0"
                                                     MinHeight="0" Height="20" Padding="0,2"
                                                     VerticalContentAlignment="Center"
                                                     LostFocus="TaskField_LostFocus" KeyDown="TaskField_KeyDown"/>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource ToolBtn}" 
                                                    Foreground="#CCC" FontSize="10"
                                                    Click="DeleteIM_Click" Tag="{Binding}"/>
                                        </Grid>
                                        <TextBox Text="{Binding Content, UpdateSourceTrigger=LostFocus}"
                                                 AcceptsReturn="True" MinHeight="30"
                                                 TextWrapping="Wrap" BorderThickness="0" Padding="2"
                                                 LostFocus="TaskField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="text">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <!-- 链接 URL 编辑框（仅 link 类型可见） -->
                                        <TextBox Text="{Binding Link, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="11" BorderBrush="#E0E0E0" BorderThickness="1"
                                                 Padding="4" Margin="0,4,0,0"
                                                 LostFocus="TaskField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="link">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <!-- 文件路径显示（仅 file 类型可见） -->
                                        <TextBox Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="11" Foreground="#888" BorderThickness="0"
                                                 Padding="2" Margin="0,2,0,0"
                                                 LostFocus="TaskField_LostFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="file">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Kind, StringFormat='类型: {0}'}" 
                                                       FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="📂 打开" FontSize="10" Foreground="#4A90D9"
                                                        Click="OpenFile_Click" Tag="{Binding FilePath}"
                                                        Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="file">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🔗 打开" FontSize="10" Foreground="#4A90D9"
                                                        Click="OpenLink_Click" Tag="{Binding Link}"
                                                        Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="link">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="✕" Style="{StaticResource ToolBtn}" 
                                                        Foreground="#CCC" FontSize="10"
                                                        Click="DeleteIM_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </Expander>
<!-- 时间（北京时间 UTC+8） -->
                    <TextBlock Text="时间" FontWeight="SemiBold" Margin="0,16,0,2" Foreground="#888" FontSize="12"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="创建：" FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Created, Converter={StaticResource UnixToBeijing}}"
                                   FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="更新：" FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Updated, Converter={StaticResource UnixToBeijing}}"
                                   FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 导出消息 -->
                    <TextBlock Text="{Binding ExportMessage}" Foreground="Green" Margin="0,8,0,0" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 库：项目所有文件汇总（公共区 + 按任务分组） -->
            <ScrollViewer x:Name="LibraryTabPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="项目文件库" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                    <TextBlock Text="所有被添加的文件，按所属任务分类；公共区的文件不属于任何任务。" FontSize="11"
                               Foreground="#AAA" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding LibraryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#888" FontSize="12"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                                        Margin="0,2" Padding="6">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource ToolBtn}"
                                                                    Foreground="#CCC" FontSize="10"
                                                                    Click="LibraryDelete_Click" Tag="{Binding}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="#888"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <Button Content="📂 打开" FontSize="10" Foreground="#4A90D9"
                                                                Click="OpenFile_Click" Tag="{Binding FilePath}"
                                                                Background="Transparent" BorderThickness="0" Padding="4,2"
                                                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 筛选弹出面板 -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=outlineTree}"
               Placement="Left" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Width="220">
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="筛选状态" FontWeight="SemiBold" Foreground="#888" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="FilterStatusCombo" SelectedIndex="0" Padding="4"
                              SelectionChanged="FilterStatusCombo_SelectionChanged">
                        <ComboBoxItem Content="全部状态"/>
                        <ComboBoxItem Content="进行中" Tag="in_progress"/>
                        <ComboBoxItem Content="已完成" Tag="done"/>
                        <ComboBoxItem Content="阻塞" Tag="blocked"/>
                        <ComboBoxItem Content="未标记" Tag=""/>
                    </ComboBox>
                    <TextBlock Text="筛选时间" FontWeight="SemiBold" Foreground="#888" FontSize="12" Margin="0,12,0,6"/>
                    <ComboBox x:Name="FilterTimeCombo" SelectedIndex="0" Padding="4"
                              SelectionChanged="FilterTimeCombo_SelectionChanged">
                        <ComboBoxItem Content="全部时间"/>
                        <ComboBoxItem Content="今天" Tag="today"/>
                        <ComboBoxItem Content="最近 7 天" Tag="week"/>
                        <ComboBoxItem Content="最近 30 天" Tag="month"/>
                    </ComboBox>
                    <Button Content="重置筛选条件" Style="{StaticResource ToolBtn}" Foreground="#4A90D9"
                            HorizontalAlignment="Right" FontSize="11" Margin="0,10,0,0"
                            Click="ResetFilter_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
