<Application x:Class="BranchTaskWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 状态颜色 -->
        <SolidColorBrush x:Key="StatusDone" Color="#4CAF50"/>
        <SolidColorBrush x:Key="StatusProgress" Color="#FF9800"/>
        <SolidColorBrush x:Key="StatusBlocked" Color="#F44336"/>
        <SolidColorBrush x:Key="StatusNone" Color="#9E9E9E"/>
        
        <!-- 通用样式 -->
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
